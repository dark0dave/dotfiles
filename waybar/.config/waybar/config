{
  "layer": "top",
  "reload_style_on_change": true,
  "reload_style_on_change": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/arch",
    "gamemode",
    "hyprland/workspaces",
    "cpu",
    "memory",
    "disk",
    "tray",
    "wlr/taskbar"
  ],
  "modules-center": [
    "custom/weather",
    "clock"
  ],
  "modules-right": [
    "mpris",
    "wireplumber#sink",
    "wireplumber#source",
    "battery",
    "bluetooth",
    "network"
  ],
  "custom/arch": {
    "format": "🐧",
    "on-click": "rofi -show drun"
  },
    "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
    "1": "一",
    "2": "二",
    "3": "三",
    "4": "四",
    "5": "五",
    "6": "六",
    "7": "七",
    "8": "八",
    "9": "九",
    "10": "十"
  },
      "persistent-workspaces": {
      "*": 10
    }
  },
    "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
    "1": "一",
    "2": "二",
    "3": "三",
    "4": "四",
    "5": "五",
    "6": "六",
    "7": "七",
    "8": "八",
    "9": "九",
    "10": "十"
  },
      "persistent-workspaces": {
      "*": 10
    }
  },
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 60,
    "exec": "wttrbar --nerd",
    "return-type": "json"
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    },
    "persistent-workspaces": {
      "*": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections} {device_battery_percentage}%",
    "format-connected-battery": " {num_connections} {device_alias} {icon} {device_battery_percentage}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "ghostty -e bluetui"
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "📵",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": " {essid} ",
    "tooltip-format-ethernet": " {ipaddr}/{cidr} ",
    "tooltip-format-disconnected": "📵",
    "on-click": "ghostty -e nmtui",
    "max-length": 10
  },
  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "icon-theme": "Numix-Circle",
    "tooltip-format": "{title}",
    "on-click": "activate",
  },
  "clock": {
    "format": "{:%c}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "max-length": 35,
    "interval": 1
  },
  "battery": {
    "format": "<span color='#a8cd76'>{icon}</span> {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-charging": "<span color='#a8cd76'></span> {capacity}%",
    "interval": 1
  },
  "wireplumber#sink": {
    "format": " <span color='#f7768e'>{icon}</span><span color='#ffff'>  {volume}% </span> ",
    "format-muted": " 🔇 {volume}% ",
    "format-icons": ["", "", ""],
    "on-click": "pwvucontrol || pavucontrol",
    "scroll-step": 5
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": " <span color='#f7768e'>{icon}</span><span color='#ffff'> {volume}% </span> ",
    "format-muted": "",
    "format-icons": [""],
    "on-click": "pwvucontrol || pavucontrol",
    "scroll-step": 5
  },
  "memory": {
    "format": "<span foreground='#9ece6a'>🎟</span> {}%",
    "on-click": "ghostty -e htop"
  },
  "tray": {
    "icon-size": 20,
    "show-passive-items": true,
    "spacing": 6,
    "expand": true
  },
  "cpu": {
    "format": "<span foreground='#ff005f'></span>  {usage}%"
  },
  "disk": {
    "interval": 30,
    "format": "<span>🖴 {percentage_used}%</span>"
  },
  "mpris": {
    "format": "{status_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "tooltip-format": "{player} ({status}) {dynamic}",
    "status-icons": {
      "playing": "▶",
      "paused": "⏸",
      "stopped": "⏸",
    },
    "ignored-players": [],
    "title-len": 30,
    "max-length": 35
  }
}
